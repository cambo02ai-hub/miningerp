# =============================================================
# JpMonitor - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!
#
# Production defaults are in .env.production (loaded by Vite on build)
# Override with environment variables at build time if needed.
# =============================================================

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api

# --- Backend Database ---
DB_HOST=jpmonitor-postgres
DB_PORT=5432
DB_NAME=jpmonitor_db
DB_USER=jpmonitor_user
DB_PASSWORD=CHANGE_ME_secure_password_here

# --- JWT Authentication ---
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_-base64_32

# --- Application ---
# Override default admin password on first run (optional)
ADMIN_PASSWORD=

# --- CORS ---
# Comma-separated list of allowed origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Telegram Bot Alerts ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_CHAT_ID=-100123456789
TELEGRAM_NOTIFICATIONS_ENABLED=true
